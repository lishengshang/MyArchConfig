[Unit]
Description=awww daemon for niri overview background (blur layer, namespace: overview)
# 跟随图形会话生命周期；wrapper 会等待当前 Wayland socket 就绪。
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=exec
# 不在 unit 中硬编码 wayland-0/wayland-1，由 wrapper 使用 session 环境或 fallback 探测。
ExecStart=/usr/bin/bash %h/.config/niri/scripts/awww-overview-daemon.sh
# daemon 启动时若合成器未就绪会连接失败退出, Restart 自愈。
# 崩溃/被杀后也会自动拉起。
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
