[Unit]
Description=唤醒后自愈 WirePlumber（休眠唤醒音频失效兜底）
# 跟随 graphical-session 生命周期：会话结束自动停止（同 swayidle.service 模式）
PartOf=graphical-session.target
After=graphical-session.target
# 防止崩溃循环：5 分钟内最多重启 5 次
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=exec
ExecStart=%h/.config/niri/scripts/audio-resume-guard.sh
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=audio-resume-guard

[Install]
WantedBy=graphical-session.target
