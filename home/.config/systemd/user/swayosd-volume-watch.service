[Unit]
Description=swayosd 音量变化监听（耳机蓝牙按键等路径的浮窗反馈）
# 跟随 graphical-session 生命周期：会话结束自动停止（同 swayidle.service 模式）
PartOf=graphical-session.target
After=graphical-session.target
# 浮窗本体先起，监听器后起（仅顺序偏好，非硬依赖）
After=swayosd.service
# 防止崩溃循环：5 分钟内最多重启 5 次
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=exec
ExecStart=%h/.config/niri/scripts/swayosd-volume-watch.sh
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=swayosd-volume-watch

[Install]
WantedBy=graphical-session.target
