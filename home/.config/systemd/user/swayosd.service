[Unit]
Description=swayosd OSD 服务（音量/锁键浮窗）
Documentation=https://github.com/ErikReider/SwayOSD
# 跟随 graphical-session 生命周期：会话结束自动停止（同 swayidle.service 模式）
PartOf=graphical-session.target
After=graphical-session.target
# 防止崩溃循环：5 分钟内最多重启 5 次
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=exec
# --duration 2500: 浮窗显示 2.5s（0.3.2 默认约 1s，肉眼容易错过，误以为"不显示"）
ExecStart=/usr/bin/swayosd-server --duration 2500
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=swayosd-server

[Install]
WantedBy=graphical-session.target
