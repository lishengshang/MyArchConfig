[Unit]
Description=Auto commit + push dotfiles changes
Documentation=file://%h/dotfiles/HOW.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/dotfiles/auto-commit.sh
# 失败不重启（避免 rebase 冲突时无限重试）
Restart=no
# 标准输出/错误都进 journal
StandardOutput=journal
StandardError=journal
# 标识日志
SyslogIdentifier=dotfiles-autocommit