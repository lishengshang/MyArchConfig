{
    // powerline 分隔符实例名带 p 前缀：waybar 把实例名注册为 CSS class，
    // GTK 拒绝数字开头的 class，数字后缀会让 style.css 对应规则整条失效。
    // 历史布局大改后箭头名与位置早已不对应，从左到右看。
    "include": [
        "modules.jsonc",
        "modules-dividers.jsonc"
    ],
    //这一行layer top设置会让waybar显示在最上方
    "layer": "top",
    //"output": "DP-2",
    "position": "top",
    "fixed-center": true,
    // "height": 30,
    "reload_style_on_change": true,
    "modules-left": [
        "niri/workspaces",
        "custom/right_div#p5",
        //"cffi/niri-taskbar", //需要安装waybar-niri-taskbar-git
        "niri/window",
        "custom/right_div#p6"
    ],
    "modules-center": [
        "custom/left_div#p3",
	// 这个模块是shorinNiri相关的常用命令
	"custom/actions",
        "custom/wfrec",
        "custom/screenshot",
	"custom/wallpapers",
	"custom/clipboard",
        "custom/left_div#p2",
        "idle_inhibitor",
        "custom/colorpicker",
        "power-profiles-daemon",
        "custom/left_div#p11",
        "custom/left_div#p1",
        "custom/applauncher",
        "custom/right_div#p1",
        "custom/right_div#p11",
        "clock",
        "custom/right_div#p2",
        "custom/cava",
        "custom/right_div#p3"
    ],
    "modules-right": [
        "custom/left_div#p7",
        "custom/updates",
        "tray",
        "custom/left_div#p4",
        "group/ddcutil",
        "privacy",
        "group/audio",
        "custom/left_div#p8",
        "bluetooth",
        "network",
        "battery",
        "custom/left_div#p5",
        "group/powermenu"
    ]
}
