{
	/*-------------------
		powerline 分隔符。
		实例名后缀必须以字母开头 (p = powerline)：waybar 会把实例名注册为
		CSS class，GTK 拒绝数字开头的 class 选择器，数字后缀会导致
		style.css 中对应规则整条失效。
		只保留 config.jsonc 实际引用的实例。
	-------------------*/
	"custom/left_div#p1": {
		"format": "",
		"tooltip": false
	},
	"custom/left_div#p11": {
		"format": "",
		"tooltip": false
	},
	"custom/left_div#p2": {
		"format": "",
		"tooltip": false
	},
	"custom/left_div#p3": {
		"format": "",
		"tooltip": false
	},
	"custom/left_div#p4": {
		"format": "",
		"tooltip": false
	},
	"custom/left_div#p5": {
		"format": "",
		"tooltip": false
	},
