  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "comment",
          "punctuation.definition.comment"
        ],
        "settings": {
          "foreground": "#bbc4f599",
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "variable",
          "variable.language",
          "variable.name",
          "variable.other",
          "variable.parameter"
        ],
        "settings": {
          "foreground": "#b8c4ff"
        }
      }
    ]
