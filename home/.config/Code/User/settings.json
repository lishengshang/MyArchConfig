  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "comment",
          "punctuation.definition.comment"
        ],
        "settings": {
          "foreground": "#bdc9c999",
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "variable",
          "variable.language",
          "variable.name",
          "variable.other",
          "variable.parameter"
        ],
        "settings": {
          "foreground": "#b6d5d6"
        }
      }
    ]
  },
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },
  "workbench.startupEditor": "none"
