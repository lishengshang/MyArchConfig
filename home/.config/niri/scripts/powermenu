#!/bin/bash
set -euo pipefail

# 语言检测
if [[ "${LANG:-}" == zh_* ]]; then
    OPT_LOCK="锁屏"
    OPT_SCREEN_OFF="关闭屏幕"
    OPT_QUIT="注销"
    OPT_SUSPEND="挂起"
    OPT_HIBERNATE="休眠"
    OPT_REBOOT="重启"
    OPT_POWEROFF="关机"
else
    OPT_LOCK="Lock"
    OPT_SCREEN_OFF="Screen Off"
    OPT_QUIT="Logout"
    OPT_SUSPEND="Suspend"
    OPT_HIBERNATE="Hibernate"
    OPT_REBOOT="Reboot"
    OPT_POWEROFF="Shutdown"
fi

OPTIONS="${OPT_LOCK}\n${OPT_SCREEN_OFF}\n${OPT_QUIT}\n${OPT_SUSPEND}\n${OPT_HIBERNATE}\n${OPT_REBOOT}\n${OPT_POWEROFF}"

# 锁屏（统一入口：hyprlock，已锁定则跳过；等待锁屏建立后再继续）
do_lock() {
    "$HOME/.config/niri/scripts/lock-screen.sh" --wait-ready
}

CHOICE=$(echo -e "$OPTIONS" | fuzzel --dmenu --width 14 --lines 7)

# 危险操作二次确认
case "$CHOICE" in
    "$OPT_REBOOT"|"$OPT_POWEROFF"|"$OPT_QUIT")
        if [[ "${LANG:-}" == zh_* ]]; then
            CONFIRM_OPTIONS="否\n是"
            CONFIRM_YES="是"
        else
            CONFIRM_OPTIONS="No\nYes"
            CONFIRM_YES="Yes"
        fi
        CONFIRM=$(echo -e "$CONFIRM_OPTIONS" | fuzzel --dmenu --width 10 --lines 2)
        [[ "$CONFIRM" != "$CONFIRM_YES" ]] && exit 0
    ;;
esac

# 执行
case "$CHOICE" in
    "$OPT_LOCK")
        do_lock
    ;;
    "$OPT_SCREEN_OFF")
        do_lock
        niri msg action power-off-monitors
    ;;
    "$OPT_QUIT")
        niri msg action quit
    ;;
    "$OPT_SUSPEND")
        systemctl suspend
    ;;
    "$OPT_HIBERNATE")
        systemctl hibernate
    ;;
    "$OPT_REBOOT")
        systemctl reboot
    ;;
    "$OPT_POWEROFF")
        systemctl poweroff
    ;;
    *)
        exit 0
    ;;
esac