include "binds.kdl"
include optional=true "rule.kdl"
include optional=true "output.kdl"
include optional=true "animations.kdl"
include optional=true "layout.kdl"
include optional=true "blur.kdl" 
include optional=true "debug.kdl"
// 截图保存位置
screenshot-path "~/Pictures/screenshots/%Y-%m-%d %H-%M-%S.png"

// 环境变量
environment {
    //LC_CTYPE "zh_CN.UTF-8" 会导致输入法出现漏字
    //LC_MESSAGES "zh_CN.UTF-8" 让系统全局使用英文，仅主要界面为英文时使用这个环境变量
    // 设置界面语言
    LANG "zh_CN.UTF-8"
    LC_CTYPE "en_US.UTF-8" //这一项可以解决漏字问题，但是也许会导致steam之类的x11应用无法使用中文输入法
    // 输入法环境变量 (Wayland 原生应用走 text-input-v3 不需要这些,以下主要给 XWayland 应用)
    XMODIFIERS "@im=fcitx"
    GTK_IM_MODULE "fcitx"
    QT_IM_MODULE "fcitx"
    SDL_IM_MODULE "fcitx"
    INPUT_METHOD "fcitx"
    // GLFW (kitty 等) 只识别 ibus 字符串,fcitx5 提供 ibus 兼容前端
    GLFW_IM_MODULE "ibus"
    // qt主题
    QT_QPA_PLATFORMTHEME "gtk3"
    QT_QPA_PLATFORMTHEME_QT6 "gtk3"
    // 解决quickshell图标主题缺失问题
    QS_ICON_THEME "Adwaita"
    // GTK软件使用的渲染器，可以解决n卡双显卡导致的GTK应用启动缓慢问题，AMD或Intel单显卡不需要这行设置可以注释掉
    // GSK_RENDERER "gl"
    // 默认文本编辑器
    EDITOR "nvim"
    // 一个可能kde遇到的环境问题
    // XDG_MENU_PREFIX "arch-"    
}

// 光标配置
cursor {
    // 主题，存放路径在~/.local/share/icons
    xcursor-theme "breeze_cursors"
    // 大小
    xcursor-size 30
    // 闲置多少毫秒自动隐藏光标
    hide-after-inactive-ms 15000
}
 
// 带缩略图的alt+tab切换窗口功能（但是我设置的是super+tab，更符合逻辑）
recent-windows {
    // 取消//off的注释可以禁用
    // off
    debounce-ms 750
    open-delay-ms 150

    highlight {
        active-color "#999999ff"
        urgent-color "#ff9999ff"
        // 缩略图背景内间距
        padding 30
        // 缩略图的背景圆角
        corner-radius 12
    }

	//设置缩略图大小
    previews {
        max-height 480
        max-scale 0.2
    }

    binds {
        // scope可以设置显示的窗口是当前工作区的、还是当前显示器的、或者显示全部窗口
        Alt+Tab         { next-window scope="workspace"; }
        Alt+Shift+Tab   { previous-window scope="workspace"; }
        // grave是波浪键，显示当前应用的所有窗口
        Alt+grave       { next-window     filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
}
// 这是include进来的颜色文件，主要设置了窗口边框
include "colors.kdl"

input {
    // focus-follows-mouse
    keyboard {
        xkb {
        }
	    repeat-delay 250
	    repeat-rate 35
    }

    // Next sections include libinput settings.
    // Omitting settings disables them, or leaves them at their default values.
    // All commented-out settings here are examples, not defaults.
    touchpad {
        // off                          // 完全禁用触控板
        tap                              // 启用轻点点击：单指=左键，双指=右键，三指=中键
        dwt                              // disable-while-typing：打字时临时禁用触控板，防误触
        // dwtp                          // disable-while-trackpointing：使用指点杆(小红帽)时禁用触控板
        // drag false                    // 关闭「轻点拖拽」（默认开启；轻点后按住可拖动）
        // drag-lock                     // 拖拽锁：拖动中短暂抬起手指仍保持拖拽状态
        // nautural-scroll可以翻转触摸板滚动的方向
        natural-scroll                   // 自然滚动：手指上滑=页面上移（macOS 风格）；关闭则反向
        //accel-speed -0.5               // 指针速度，范围 -1.0~1.0，负值变慢、正值变快
        accel-profile "flat"          // 加速曲线："flat" 线性无加速；"adaptive"(默认) 自适应加速
        // scroll-method "two-finger"    // 滚动方式：two-finger 双指 / edge 边缘 / on-button-down 按键时滚动 / no-scroll
        // disabled-on-external-mouse    // 接入外部鼠标时自动禁用触控板
        scroll-factor 0.3                // 滚动速度倍数：<1 变慢，>1 变快
    }

    mouse {
        // 鼠标速度
        accel-speed 0
        // 禁用鼠标加速 
        accel-profile "flat"
    }

    trackpoint {
    }

}

overview {
	workspace-shadow {
	// off
	}
	//缩放
	zoom 0.5
}

gestures {
        hot-corners {
            off
        }
    }

// 自动启动设置
// 使用文件监听自动更新
spawn-at-startup "~/.config/niri/scripts/auto-update-cache.sh"
//启用这个nm-applet 需要下载 --> sudo pacman -S network-manager-applet nm-connection-editor   
spawn-at-startup "nm-applet"

// 桌面壁纸的守护进程
// --no-cache: 启动时不恢复上次壁纸, 避免与下方 waypaper --random 叠加产生"先旧后新"的闪烁
spawn-at-startup "awww-daemon" "--no-cache"
// 总览界面背景壁纸的守护进程
spawn-at-startup "awww-daemon" "-n" "overview"
// 随机更换一张壁纸: 轮询等待 awww 就绪后立即执行, 缩短开机时无壁纸的窗口
spawn-sh-at-startup "for i in $(seq 1 30); do awww query >/dev/null 2>&1 && break; sleep 0.1; done; waypaper --random"
// 恢复壁纸
//spawn-at-startup "waypaper" "--restore"

// 询问管理员权限功能（身份验证）
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"

// 屏幕分享、录屏相关的环境设置,如果屏幕分享出异常的话可以开启
spawn-sh-at-startup "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=niri & /usr/lib/xdg-desktop-portal-gnome"

// GNOME tracker修复
// spawn-sh-at-startup "systemctl --user set-environment XDG_SESSION_CLASS=user"
// 通知程序
spawn-at-startup "mako"

// 任务栏
spawn-at-startup "waybar"

// 输入法
spawn-at-startup "fcitx5" 

// 剪贴板守护进程
//cliphist
// wayland <--> x11 剪贴板同步 这个包是我自己推的clipsync-git
spawn-at-startup "wl-paste" "--watch" "cliphist" "store"
//spawn-at-startup "systemctl" "--user" "start" "linuxqq-clipsync"

// 闲置时自动熄屏锁屏睡眠：由 systemd user service 管理
// 启用：systemctl --user enable --now swayidle.service
// 回退方案：取消下一行注释，改用 niri 启动（注意 flock 会防止重复实例）
//spawn-at-startup "~/.config/niri/scripts/swayidle.sh"

// 大写锁定键的osd显示
spawn-at-startup "swayosd-server"

// 自动开启护眼模式,经纬度设置位置
// spawn-at-startup "~/.local/bin/toggle-wlsunset"

// niri-siderbar
spawn-at-startup "~/.local/bin/niri-sidebar" "listen"

// 允许root通过用户的xwayland打开窗口
// 注释掉：xhost 未安装，Wayland 环境下通常不需要
// 如需使用，安装 xorg-xhost 后取消注释
spawn-at-startup "xhost" "+si:localuser:root"

// 音频调整程序，easyeffects，-w可以在后台启动
spawn-at-startup "easyeffects" "-w"
// nirius
spawn-at-startup "niriusd"
// nirinit 会话保存：开机只保存不恢复，手动恢复用 ~/.config/niri/scripts/nirinit-restore.sh
spawn-at-startup "~/.cargo/bin/nirinit" "--save-interval" "300" "--no-restore"

// 取消启动niri时自动开启快捷键教程
hotkey-overlay {
     skip-at-startup
}

// 隐藏窗口标题栏
prefer-no-csd


// alt+tab切换器（这是一个第三方，无缩略图显示的切换器）
//spawn-at-startup "niriswitcher"