# =============================================================================
# Dotfiles bare repo .gitignore - 工作区是 $HOME
# =============================================================================
# 策略:默认忽略一切，白名单你想版本控制的配置。
# 添加新配置的两种方式:
#   1. 手动编辑此文件，加 !path/to/file
#   2. 用 dota 命令: dota .config/foo/bar （它会 dot add，但仍需在此白名单）
# =============================================================================

# 默认忽略所有文件
/*

# === 必备元文件 ===
!.gitignore
!.zshenv
!README.md

# === GitHub Actions CI ===
!.github/
.github/*
!.github/workflows/
.github/workflows/*
!.github/workflows/lint.yml

# === 让 git 进入 .config 目录，但默认忽略其下所有内容 ===
!.config/
.config/*

# === dotfiles 自身管理目录（setup/bootstrap/文档/包列表）===
!.config/dotfiles/

# === shell ===
!.config/zsh/
!.config/fish/
!.config/bash/
!.config/environment.d/

# === 窗口管理器 / 桌面 ===
!.config/niri/
!.config/waybar/
!.config/mako/
!.config/fuzzel/
!.config/swaylock/
!.config/swayosd/
!.config/waypaper/

# === 编辑器 / 终端 ===
!.config/nvim/
!.config/vim/
!.config/kitty/
!.config/ghostty/

# === 媒体 / 浏览 ===
# mpv 不在白名单：它是独立 git 仓库，有自己的 .git/.gitignore，
# 重装时单独 clone mpv 仓库到 ~/.config/mpv/（见下方黑名单）
!.config/yazi/
!.config/fastfetch/
!.config/btop/
!.config/cava/
!.config/matugen/

# === 输入法 / 字体 ===
!.config/fcitx5/
!.config/fontconfig/

# === 主题 / 外观 ===
!.config/gtk-3.0/
!.config/gtk-4.0/
!.config/starship/

# === 自定义脚本 ===
!.config/scripts/

# === systemd user units（自动备份 timer 等）===
!.config/systemd/
.config/systemd/*
!.config/systemd/user/
.config/systemd/user/*
!.config/systemd/user/dotfiles-autocommit.service
!.config/systemd/user/dotfiles-autocommit.timer

# =============================================================================
# 黑名单：在白名单目录内重新排除缓存 / 生成物 / 平台特定文件
# 这些文件不应版本控制，换机器会自动重新生成
# =============================================================================

# --- mpv: 它本身是独立 git 仓库，有自己的 .git/.gitignore，不纳入 dotfiles ---
# 重装时单独 clone mpv 仓库到 ~/.config/mpv/
.config/mpv/

# --- zsh 补全缓存（自动生成）---
.config/zsh/.zcompdump
.config/zsh/.zcompdump.*

# --- fish 补全缓存（fisher / 工具自动生成）---
.config/fish/completions/
.config/fish/fish_history
.config/fish/fish_variables

# --- fcitx5 缓存 ---
.config/fcitx5/conf/cached_layouts
.config/fcitx5/cache/

# --- 通用编辑器临时文件 ---
*.swp
*.swo
*~
.netrwhist

# === 敏感文件（双重保险）===
.env
.env.*
*.pem
*.key
*.secret
credentials
.ssh/
.gnupg/

# === 备份残留 ===
*.bak
*.bak.*
*backup*
.dotfiles-backup*

# =============================================================================
# matugen 派生产物（由 ~/.config/matugen/config.toml 全量覆盖写入）
# =============================================================================
# 这些是生成产物，换机器后 setup.sh 会跑一次 matugen-update.sh 自动重生成。
# 想改这些文件的内容，改 ~/.config/matugen/templates/* 里的【模板】，不是改产物——
# 产物每次 matugen 跑都会被覆盖，手改的内容会丢。
# starship.toml 不在此列表：它由 post_hook(base.toml + colors.toml) 拼接生成，
# 白名单只放了 .config/starship/ 目录，starship.toml 本身被 .config/* 默认忽略。
.config/btop/themes/matugen.theme
.config/cava/themes/matugen
.config/fastfetch/config.jsonc
.config/fish/conf.d/35-pager-matugen.fish
.config/fuzzel/colors.ini
.config/ghostty/themes/Matugen
.config/gtk-3.0/colors.css
.config/gtk-4.0/colors.css
.config/kitty/themes/matugen.conf
.config/kitty/current-theme.conf
.config/mako/colors.conf
.config/niri/colors.kdl
.config/nvim/generated.lua
.config/starship/colors.toml
.config/swaylock/config
.config/swayosd/colors.css
.config/waybar/colors.css
.config/yazi/theme.toml

# --- waypaper: 记录当前壁纸路径，换壁纸就变，机器特定 ---
.config/waypaper/config.ini
