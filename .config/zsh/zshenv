# =============================================================================
# ~/.zshenv — environment variables (sourced by ALL zsh instances)
# =============================================================================
# Keep this file minimal: only vars needed by non-interactive shells too.
# Interactive-only exports go in ~/.config/zsh/env.zsh

# XDG base directories
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"

# Ensure ~/.local/bin is available early (hermes, pipx, etc.)
export PATH="$HOME/.local/bin:$PATH"

# Prevent Zinit from calling compinit on its own.
# We handle compinit EXACTLY ONCE in ~/.config/zsh/completions.zsh,
# after all plugins and fpath entries are set up.
export skip_global_compinit=1
