#compdef procs

autoload -U is-at-least

_procs() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-W+[监视模式, 自定义间隔]:秒数:_default' \
'--watch-interval=[监视模式, 自定义间隔]:秒数:_default' \
'*-i+[插入列到指定位置]:类型:_default' \
'*--insert=[插入列到指定位置]:类型:_default' \
'--only=[只显示指定列]:类型:_default' \
'(--sortd -t --tree)--sorta=[按列升序排列]:类型:_default' \
'(--sorta -t --tree)--sortd=[按列降序排列]:类型:_default' \
'-c+[颜色模式]:颜色:(auto always disable)' \
'--color=[颜色模式]:颜色:(auto always disable)' \
'--theme=[主题模式]:主题:(auto dark light)' \
'-p+[分页器模式]:分页器:(auto always disable)' \
'--pager=[分页器模式]:分页器:(auto always disable)' \
'--interval=[计算吞吐量的间隔]:毫秒:_default' \
'--use-config=[使用内置配置]:名称:(default large)' \
'--load-config=[从文件加载配置]:路径:_files' \
'--gen-completion=[生成 shell 补全文件]:shell:(bash elvish fish powershell zsh)' \
'--gen-completion-out=[生成 shell 补全文件并输出到 stdout]:shell:(bash elvish fish powershell zsh)' \
'--procfs=[procfs 路径]:PROCFS:_files' \
'(-o --or -d --nand -r --nor)-a[多关键字 AND 逻辑]' \
'(-o --or -d --nand -r --nor)--and[多关键字 AND 逻辑]' \
'(-a --and -d --nand -r --nor)-o[多关键字 OR 逻辑]' \
'(-a --and -d --nand -r --nor)--or[多关键字 OR 逻辑]' \
'(-a --and -o --or -r --nor)-d[多关键字 NAND 逻辑]' \
'(-a --and -o --or -r --nor)--nand[多关键字 NAND 逻辑]' \
'(-a --and -o --or -d --nand)-r[多关键字 NOR 逻辑]' \
'(-a --and -o --or -d --nand)--nor[多关键字 NOR 逻辑]' \
'-l[显示类型列表]' \
'--list[显示类型列表]' \
'--thread[显示线程]' \
'-t[树形视图]' \
'--tree[树形视图]' \
'-w[监视模式, 默认间隔 1 秒]' \
'--watch[监视模式, 默认间隔 1 秒]' \
'--json[JSON 格式输出]' \
'--gen-config[生成示例配置文件]' \
'--no-header[隐藏表头]' \
'--debug[显示调试信息]' \
'-h[显示帮助]' \
'--help[显示帮助]' \
'-V[显示版本]' \
'--version[显示版本]' \
'*::关键字 -- 搜索关键字:_default' \
&& ret=0
}

(( $+functions[_procs_commands] )) ||
_procs_commands() {
    local commands; commands=()
    _describe -t commands 'procs 命令' commands "$@"
}

if [ "$funcstack[1]" = "_procs" ]; then
    _procs "$@"
else
    compdef _procs procs
fi
