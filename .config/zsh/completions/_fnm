    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--node-dist-mirror=[<https\://nodejs.org/dist/> mirror]:NODE_DIST_MIRROR:_default' \
'--fnm-dir=[fnm 安装根目录]:BASE_DIR:_files' \
'--multishell-path=[当前 Node 版本链接的存储位置. This value will be populated automatically by evaluating \`fnm env\` in your shell profile. Read more about it using \`fnm help env\`]:MULTISHELL_PATH:_files' \
'--log-level=[fnm 命令日志级别]:LOG_LEVEL:(quiet error info)' \
'--arch=[覆盖已安装 Node 的架构, 默认与 fnm 相同]:ARCH:_default' \
'--version-file-strategy=[A strategy for how to resolve the Node version. Used whenever \`fnm use\` or \`fnm install\` is called without a version, or when \`--use-on-cd\` is configured on evaluation]:VERSION_FILE_STRATEGY:((local\:"使用当前目录定义的 Node 版本"
recursive\:"使用当前目录及所有父目录中定义的 Node 版本"))' \
'--resolve-engines=[Resolve \`engines.node\` field in \`package.json\` whenever a \`.node-version\` or \`.nvmrc\` file is not present. This feature is enabled by default. To disable it, provide \`--resolve-engines=false\`.]' \
'--corepack-enabled[Enable corepack support for each new installation. This will make fnm call \`corepack enable\` on every Node.js installation. For more information about corepack see <https\://nodejs.org/api/corepack.html>]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[显示版本]' \
'--version[显示版本]' \
":: :_fnm_commands" \
"*::: :->fnm" \
&& ret=0
    case $state in
    (fnm)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:fnm-command-$line[1]:"
        case $line[1] in
            (list-remote)
_arguments "${_arguments_options[@]}" : \
'--filter=[按版本号或 semver 范围过滤]:FILTER:_default' \
