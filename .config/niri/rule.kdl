// 放进overview里的壁纸程序
layer-rule{
    match namespace="awww-daemonoverview"
    match namespace="swww-daemonoverview"
     place-within-backdrop true
}

// 全局窗口规则（不设置透明度，降低性能消耗）
window-rule {
    // 圆角
    geometry-corner-radius 8
    // 去掉超出圆角的窗口内容
    clip-to-geometry true
    // 禁止边框画到背景里
    draw-border-with-background false
    // 默认不透明
    opacity 1.0
}

// Kitty 终端透明度
window-rule {
    match app-id="kitty"
    opacity 0.92
}

// Ghostty 终端透明度
window-rule {
    match app-id="ghostty"
    opacity 0.92
}

// 取消图片预览、视频播放器之类的透明度，并且以浮动模式打开
window-rule {
    match title="图片查看器"
    match title="画中画"
    match title="图片和视频"
    match title="视频播放器"
    open-floating true
    opacity 1.0
}

// niri-siderbar需要的全局窗口规则
window-rule {
    match is-floating=true
    min-width 100
    min-height 100
}

// 以浮动模式打开imv（一个轻量化图片预览程序）且不自动聚焦
window-rule {
    match app-id="imv"
    open-floating true
}

// shorinclip剪贴板TUI 
window-rule{
	match app-id="shorinclip"
	match app-id="cliphist-tui"
	default-column-width { fixed 500; }
    default-window-height { fixed 675; }
    //min-height 800
	open-floating true
	default-floating-position x=50 y=100 relative-to="top"
}

// window-rule{
// 	match app-id="yesplaymusic"
//     default-column-width { proportion 0.75; }
//     default-window-height { proportion 0.75; }
//     //min-height 800
// 	open-floating true
// 	//default-floating-position x=50 y=100 relative-to="top"
