#!/bin/bash

# 检测系统语言环境变量，如果包含 "zh_" 则使用中文，否则使用默认的英文
if [[ "$LANG" == zh_* ]]; then
    OPT_LOCK="锁屏"
    OPT_SCREEN_OFF="关闭屏幕"
    OPT_QUIT="退出"
    OPT_SUSPEND="挂起"
    OPT_HIBERNATE="休眠"
    OPT_REBOOT="重启"
    OPT_POWEROFF="关机"
else
    OPT_LOCK="Lock"
    OPT_SCREEN_OFF="Screen Off"
    OPT_QUIT="Logout"
    OPT_SUSPEND="Suspend"
    OPT_HIBERNATE="Hibernate"
    OPT_REBOOT="Reboot"
    OPT_POWEROFF="Shutdown"
fi

# 定义菜单项内容
OPTIONS="${OPT_LOCK}\n${OPT_SCREEN_OFF}\n${OPT_QUIT}\n${OPT_SUSPEND}\n${OPT_HIBERNATE}\n${OPT_REBOOT}\n${OPT_POWEROFF}"

# 锁屏命令统一定义，方便修改
LOCK_CMD="hyprlock -c ~/.config/niri/hyprlock.conf || swaylock"

# 使用 fuzzel 以 dmenu 模式显示
CHOICE=$(echo -e "$OPTIONS" | fuzzel --dmenu --width 14 --lines 7)

# 危险操作二次确认
case "$CHOICE" in
    "$OPT_REBOOT"|"$OPT_POWEROFF"|"$OPT_QUIT")
        if [[ "$LANG" == zh_* ]]; then
            CONFIRM_MSG="确认${CHOICE}？(y/N)"
        else
            CONFIRM_MSG="Confirm ${CHOICE}? (y/N)"
        fi
        CONFIRM=$(echo -e "否\n是" | fuzzel --dmenu --width 10 --lines 2 --prompt "$CONFIRM_MSG")
        [[ "$CONFIRM" != "是" && "$CONFIRM" != "Yes" ]] && exit 0
    ;;
esac

# 执行对应操作
case "$CHOICE" in
    "$OPT_LOCK")
        eval "$LOCK_CMD"
    ;;
    "$OPT_SCREEN_OFF")
        niri msg action power-off-monitors
    ;;
    "$OPT_QUIT")
        niri msg action quit
    ;;
    "$OPT_SUSPEND")
        niri msg action power-off-monitors && eval "$LOCK_CMD" && systemctl suspend
    ;;
    "$OPT_HIBERNATE")
        niri msg action power-off-monitors && eval "$LOCK_CMD" && systemctl hibernate
    ;;
    "$OPT_REBOOT")
        systemctl reboot
    ;;
    "$OPT_POWEROFF")
        systemctl poweroff
    ;;
    *)
        exit 0
    ;;
esac