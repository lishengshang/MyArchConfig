[Unit]
Description=Every 3 days dotfiles auto-commit timer
Documentation=file://%h/.config/dotfiles/autocommit.md

[Timer]
# 每月 1/4/7/10/13/16/19/22/25/28 号凌晨 3 点跑一次（间隔 3 天）
OnCalendar=*-*-1/3 03:00:00
# 错过的时间（关机/休眠时）开机后补跑
Persistent=true
# 如果错过了多次触发，只跑一次（不堆积）
Unit=dotfiles-autocommit.service

[Install]
WantedBy=timers.target
